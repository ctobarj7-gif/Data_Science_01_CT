      "source": [
        "# IMPORTAR LIBRERIAS\n",
        "\n",
        "# Importamos Spark\n",
        "from pyspark.sql import SparkSession\n",
        "from pyspark.sql.functions import col, hour, when\n",
        "# Importamos herramientas para preparar los datos\n",
        "from pyspark.ml.feature import StringIndexer, VectorAssembler\n",
        "from pyspark.ml import Pipeline\n",
        "# Importamos el modelo de clasificación\n",
        "from pyspark.ml.classification import LogisticRegression\n",
        "# Importamos las métricas de evaluación\n",
        "from pyspark.ml.evaluation import MulticlassClassificationEvaluator\n",
        "from pyspark.ml.evaluation import BinaryClassificationEvaluator"
      ],
      "metadata": {
        "id": "L71oWUfR3vRf"
      },
      "execution_count": null,
      "outputs": []
    },
    {
      "cell_type": "code",
      "source": [
        "# CREAR LA SESION DE SPARK\n",
        "spark = SparkSession.builder.appName(\"Modelo predictivo de ventas\").getOrCreate()"
      ],
      "metadata": {
        "id": "LHkIsJfn38gQ"
