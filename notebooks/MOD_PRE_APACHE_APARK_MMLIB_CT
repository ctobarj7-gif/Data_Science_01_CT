    {
      "cell_type": "code",
      "source": [
        "# REQUERIMIENTO 1: Preparar el dataset para entrenamiento del modelo\n",
        "\n",
        "import pandas as pd\n",
        "\n",
        "# Leemos el archivo Excel\n",
        "datos_pandas = pd.read_excel(\"/content/drive/MyDrive/Colab Notebooks/03. Apoyo prueba - ventas_simuladas.xlsx\")\n",
        "# Guardamos los datos como archivo CSV\n",
        "datos_pandas.to_csv(\"ventas_simuladas.csv\", index=False)\n",
        "\n",
        "# Ahora cargamos el archivo utilizando Spark:\n",
        "df = spark.read.csv(\n",
        "\"ventas_simuladas.csv\",\n",
        "header=True,\n",
        "inferSchema=True\n",
        ")\n",
        "# Observamos los datos\n",
        "df.show(5)\n",
        "\n",
        "# Revisar la estructura del DataFrame\n",
        "df.printSchema()\n",
        "\n",
        "# En este dataset existen algunos valores incorrectos o inconsistentes\n",
        "# Se realiza limpieza básica antes de entrenar el modelo.\n",
        "\n",
        "#  Limpiar y preparar las variables numéricas\n",
        "\n",
        "from pyspark.sql.functions import regexp_extract, to_timestamp, try_to_timestamp, lit\n",
        "# Extraemos solamente los valores numéricos\n",
        "df = df.withColumn(\n",
        "\"Cantidad\",\n",
        "regexp_extract(col(\"Cantidad\").cast(\"string\"), r\"(\\d+\\.?\\d*)\",1).cast(\"double\")\n",
        ")\n",
        "df = df.withColumn(\n",
        "\"Precio_Unitario\",\n",
        "regexp_extract(col(\"Precio_Unitario\").cast(\"string\"), r\"(\\d+\\.?\\d*)\",1).cast(\"double\")\n",
        ")\n",
        "df = df.withColumn(\n",
        "\"Monto_Total\", regexp_extract(col(\"Monto_Total\").cast(\"string\"), r\"(\\d+\\.?\\d*)\",\n",
        "1).cast(\"double\")\n",
        ")\n",
        "\n",
        "# Preparar la columna de fecha y hora\n",
        "# Transformamos Fecha_Hora a formato fecha\n",
        "df = df.withColumn(\n",
        "\"Fecha_Hora\",\n",
        "try_to_timestamp(col(\"Fecha_Hora\"), lit(\"yyyy-MM-dd HH:mm:ss\"))\n",
        ")\n",
        "\n",
        "# Eliminamos nulos\n",
        "\n",
        "df = df.dropna(\n",
        "subset=[\n",
        "\"Sucursal\",\n",
        "\"Producto\",\n",
        "\"Cantidad\",\n",
        "\"Precio_Unitario\",\n",
        "\"Monto_Total\",\n",
        "\"Fecha_Hora\"\n",
        "]\n",
        ")\n",
        "\n",
        "# Crear una variable con la hora de la venta\n",
        "df = df.withColumn(\n",
        "\"Hora\",\n",
        "hour(col(\"Fecha_Hora\"))\n",
        ")\n",
        "\n",
        "# 1 = Transaccion Riesgoso\n",
        "# 0 = Transaccion Normal\n",
        "\n",
        "df = df.withColumn(\n",
        "\"label\",\n",
        "when(\n",
        "(col(\"Monto_Total\") > 7000) &\n",
        "(col(\"Hora\") >= 0) &\n",
        "(col(\"Hora\") < 6),\n",
        "1\n",
        ").otherwise(0)\n",
        ")\n",
        "\n",
        "df.select(\n",
        "\"Monto_Total\",\n",
        "\"Hora\",\n",
        "\"label\"\n",
        ").show(10)\n",
        "\n",
        "# Aplicar StringIndexer\n",
        "indexador_sucursal = StringIndexer(\n",
        "inputCol=\"Sucursal\",\n",
        "outputCol=\"Sucursal_index\",\n",
        "handleInvalid=\"keep\"\n",
        ")\n",
        "indexador_producto = StringIndexer(\n",
        "inputCol=\"Producto\",\n",
        "outputCol=\"Producto_index\",\n",
        "handleInvalid=\"keep\"\n",
        ")\n",
        "\n",
        "# Aplicar VectorAssembler\n",
        "assembler = VectorAssembler(\n",
        "inputCols=[\n",
        "\"Sucursal_index\",\n",
        "\"Producto_index\",\n",
        "\"Cantidad\",\n",
        "\"Precio_Unitario\",\n",
        "\"Monto_Total\",\n",
        "\"Hora\"\n",
        "],\n",
        "outputCol=\"features\"\n",
        ")\n",
        "\n",
        "# Crear un Pipeline para preparar los datos\n",
        "pipeline_preparacion = Pipeline(\n",
        "stages=[\n",
        "indexador_sucursal,\n",
        "indexador_producto,\n",
        "assembler\n",
        "]\n",
        ")\n",
        "\n",
        "# Aplicamos las transformaciones.\n",
        "modelo_preparacion = pipeline_preparacion.fit(df)\n",
        "df_final = modelo_preparacion.transform(df)\n",
        "\n",
        "# Se muestran las columnas solicitadas en el enunciado:\n",
        "df_final.select(\n",
        "\"features\",\n",
        "\"label\"\n",
        ").show(10, truncate=False)\n",
        "\n",
        "\n"
      ],
