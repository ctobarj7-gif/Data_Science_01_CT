      "source": [
        "print (\"REQUERIMIENTO 2: Entrenar un modelo supervisado de clasificación con MLlib\")\n",
        "\n",
        "# Utilizamos randomSplit para dividir los datos\n",
        "datos_entrenamiento, datos_prueba = df_final.randomSplit(\n",
        "[0.8, 0.2],\n",
        "seed=42\n",
        ")\n",
        "\n",
        "print(\"Datos de entrenamiento:\", datos_entrenamiento.count())\n",
        "print(\"Datos de prueba:\", datos_prueba.count())\n",
        "\n",
        "# Crear el modelo\n",
        "modelo = LogisticRegression(\n",
        "featuresCol=\"features\",\n",
        "labelCol=\"label\"\n",
        ")\n",
        "\n",
        "# Entrenar el modelo\n",
        "modelo_entrenado = modelo.fit(datos_entrenamiento)\n",
        "predicciones = modelo_entrenado.transform(datos_prueba)\n",
        "\n",
        "predicciones.select(\n",
        "\"label\",\n",
        "\"prediction\",\n",
        "\"probability\"\n",
        ").show(20, truncate=False)\n"
